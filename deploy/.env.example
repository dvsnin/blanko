# Конфигурация локального стенда Blanko.
# Скопируйте в deploy/.env и при необходимости замените значения:
#     cp deploy/.env.example deploy/.env
# make up создаёт deploy/.env автоматически, если его нет.
#
# Значения ниже безопасны только для локального запуска на своей машине.
# Для публичного развёртывания замените КАЖДОЕ из них.

# --- PostgreSQL приложения -------------------------------------------------
APP_POSTGRES_USER=postgres
APP_POSTGRES_PASSWORD=postgres
APP_POSTGRES_DB=app
# Порт на хосте, по которому БД доступна для отладки (внутри сети всегда 5432)
APP_POSTGRES_PORT=5433

# --- PostgreSQL для Keycloak -----------------------------------------------
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=keycloak
KC_POSTGRES_DB=keycloak

# --- Административная учётная запись Keycloak ------------------------------
# Доступна на http://keycloak.localhost
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- OIDC-клиент oauth2-proxy ----------------------------------------------
# ВАЖНО: должен совпадать со значением "secret" клиента blanko
# в deploy/keycloak/realm-blanko.json, иначе логин сломается.
OIDC_CLIENT_SECRET=super-secret-pass

# --- oauth2-proxy ----------------------------------------------------------
# Ровно 16, 24 или 32 байта. Новый: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=1234567890123456abcd1234abcd5678

# --- Лицензия tldraw -------------------------------------------------------
# Можно оставить пустым: локально (HTTP на loopback) SDK считает окружение
# разработкой и ключ не проверяет. Для публичного развёртывания по HTTPS
# ключ обязателен — без него холст перестаёт рендериться через 5 секунд.
# Получить: https://tldraw.dev/get-a-license/hobby
# Ключ публичный по дизайну, проверяется на клиенте.
TLDRAW_LICENSE_KEY=
