# Root .gitignore for Blanko monorepo (Go backend + JS frontend apps + packages)
# Tailored for: backend/ (Go), frontend/* (dashboard), packages/* (shared UI/SDK)
# Keep or adjust any lines that conflict with files you intentionally commit.

########################
# System / general
########################
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# temp files
*.swp
*~
*.tmp
*.temp

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# archives
*.zip
*.tar.gz
*.rar

########################
# Node / JS (frontend & packages)
########################
# node_modules (top-level & nested)
node_modules/
**/node_modules/

# pnpm store / workspace files (pnpm creates a root store)
.pnpm-store/
.pnpmfile.cjs

# Keep pnpm lockfile and workspace config committed; ignore npm/yarn lockfiles
package-lock.json
yarn.lock

# Vite / bundlers / caches
.vite/
.vitepress/dist
.vite-env.d.ts
.dist/
.build/
out/
build/
dist/
.esbuild/
.cache/
.cache-loader/
.next/
.nuxt/
.parcel-cache/
.snowpack/
.tmp/

# Storybook
.out/
.storybook-static/

# rollup / webpack / parcel artifacts
*.map
*.bundle.js

# local env files
# Внимание: gitignore не поддерживает комментарий в конце строки с паттерном —
# всё, что справа, становится частью паттерна. Держим паттерны «голыми».
.env
.env.*
# ...кроме шаблона конфигурации, он должен быть в репозитории:
!.env.example

# lockfiles created by editors / OS
*.orig

########################
# pnpm / turborepo / tools
########################
.turbo/
.turbo-cache/
.nx/
.cache/

########################
# Frontend app artifacts (frontend/*)
########################
# If Vite builds into frontend/<app>/dist or backend static output, ignore those build outputs:
frontend/*/dist/
frontend/*/build/
frontend/*/out/
frontend/*/public/build/

# If you configured builds to output into backend static paths, ignore them there too:
# (allow overriding: if you intend to commit built static assets, remove these)
backend/app/static/*
backend/app/public/
# keep a .gitkeep if you want the directory in repo:
!backend/app/static/.gitkeep
!backend/app/public/.gitkeep
# canvas/ — рукописный tldraw-исходник, не build artifact:
!backend/app/static/canvas/

########################
# Go (backend)
########################
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary built with `go test -c`
*.test

# Coverage and test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace (optional: commit go.work/go.work.sum if you want reproducible builds in repo)
# If you prefer to keep go.work in repo, remove these lines.
go.work
go.work.sum

# Build output (common bin directories)
bin/
_build/
build/

# vendor directory (only if you don't commit vendor/)
vendor/

# Go module cache (usually not inside repo)
GOMODCACHE/

########################
# Generated files (codegen / proto / SDK)
########################
# If you generate code into packages/sdk or packages/proto, ignore their generated outputs
packages/*/dist/
packages/*/lib/
packages/*/build/
packages/*/generated/
packages/*/out/

# Protobuf generated artifacts (if generated into repo paths)
**/*_pb.*
**/*_grpc.pb.*

########################
# IDEs / Editors
########################
# JetBrains
.idea/
*.iml
out/

# VS Code
.vscode/
.history/

# Emacs
*~
\#*\#
.\#*

# Sublime
*.sublime-project
*.sublime-workspace

########################
# Docker
########################
# local docker files
docker-compose.override.yml
docker-compose.*.yml
**/Dockerfile.local

# docker build outputs
docker-compose.*.local

# containers / images (if you accidentally create)
*.tgz

########################
# OS / misc
########################
# Thumbnails, desktop files
Thumbs.db
desktop.ini

# macOS Finder
.DS_Store

# Certificates / keys
*.pem
*.key
*.cer

# secrets
.secret
secrets.*
credentials
*.p12
*.jks

########################
# Misc useful ignores
########################
# Generated docs
docs/_build/
site/
public/

# temporary test folders
tmp/
temp/

# lockfiles generated by other package managers, if any
yarn-error.log
pnpm-debug.log

########################
# Local development overrides
########################
# Ignore local overrides (Vite/env / IDE / local config)
.env.local
.env.development.local
.env.production.local
.local/

# MacOS Finder metadata
.AppleDB
.AppleDesktop

########################
# Superpowers (brainstorming/spec workspace) and local docs
########################
.superpowers/
docs/