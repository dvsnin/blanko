{
  "name": "blanko-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "pnpm -w install",
    "dev:dashboard": "pnpm --filter @blanko/dashboard dev",
    "build:dashboard": "pnpm --filter @blanko/dashboard build",
    "build:all": "pnpm -w run -r build"
  },
  "devDependencies": {
    "pnpm": "^10"
  }
}